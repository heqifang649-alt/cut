{
  "name": "gc-cutflow-team-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "worker": "node worker/processor.mjs",
    "worker:templates": "node worker/template-processor.mjs",
    "worker:delivery": "node worker/delivery-watcher.mjs",
    "worker:chatcut": "node worker/chatcut-sync.mjs",
    "worker:once": "node worker/processor.mjs --once",
    "test": "next build",
    "test:unit": "node --test tests/stability.test.mjs",
    "test:core": "node --test tests/core/index.test.mjs",
    "test:migration": "node --test tests/migration/index.test.mjs",
    "test:golden": "node --test tests/golden/index.test.mjs",
    "test:integration": "node --test tests/integration/index.test.mjs",
    "test:legacy": "node --test tests/legacy/index.test.mjs",
    "test:repository": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "next build"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
